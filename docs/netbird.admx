            presentation="$(presentation.DefaultViewMode_Pres)">
      <parentCategory ref="NetBird" />
      <supportedOn ref="SUPPORTED_NetBird_All" />
      <elements>
        <enum id="DefaultViewMode_Enum" valueName="DefaultViewMode" required="true">
          <item displayName="$(string.DefaultViewMode_Default)"><value><string>default</string></value></item>
          <item displayName="$(string.DefaultViewMode_Advanced)"><value><string>advanced</string></value></item>
        </enum>
      </elements>
    </policy>

    <policy name="DefaultTheme"
            class="Machine"
            displayName="$(string.DefaultTheme_Name)"
            explainText="$(string.DefaultTheme_Help)"
            key="Software\Policies\NetBird"
            presentation="$(presentation.DefaultTheme_Pres)">
      <parentCategory ref="NetBird" />
      <supportedOn ref="SUPPORTED_NetBird_All" />
      <elements>
        <enum id="DefaultTheme_Enum" valueName="DefaultTheme" required="true">
          <item displayName="$(string.DefaultTheme_System)"><value><string>system</string></value></item>
          <item displayName="$(string.DefaultTheme_Light)"><value><string>light</string></value></item>
          <item displayName="$(string.DefaultTheme_Dark)"><value><string>dark</string></value></item>
        </enum>
