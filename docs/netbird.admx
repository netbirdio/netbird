    <policy name="MTU"
            class="Machine"
            displayName="$(string.MTU_Name)"
            explainText="$(string.MTU_Help)"
            key="Software\Policies\NetBird"
            presentation="$(presentation.MTU_Pres)">
      <parentCategory ref="NetBird" />
      <supportedOn ref="SUPPORTED_NetBird_All" />
      <elements>
        <decimal id="MTU_Decimal" valueName="MTU"
                 minValue="576" maxValue="8192" required="true" />
      </elements>
    </policy>

    <policy name="InterfaceName"
            class="Machine"
            displayName="$(string.InterfaceName_Name)"
            explainText="$(string.InterfaceName_Help)"
