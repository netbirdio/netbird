<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           revision="1.0"
                           schemaVersion="1.0"
                           xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>NetBird Client Policies</displayName>
  <description>Group Policy template for NetBird client MDM-managed settings. Values are written under HKLM\Software\Policies\NetBird and consumed by the netbird daemon at startup and every 1-minute reload tick.</description>
  <resources>
    <stringTable>

      <!-- Categories -->
      <string id="NetBird_Category">NetBird</string>
      <string id="SUPPORTED_NetBird_All">NetBird Client 0.40+</string>

      <!-- Identity / auth -->
      <string id="ManagementURL_Name">Management URL</string>
      <string id="ManagementURL_Help">URL of the NetBird management server. Format: https://host[:port]. When set, users cannot override this value via UI or CLI.</string>

      <string id="PreSharedKey_Name">Pre-shared key</string>
      <string id="PreSharedKey_Help">WireGuard pre-shared key used as an additional symmetric secret on every peer-to-peer tunnel. Secret value.</string>

      <!-- Settings: engine / runtime behavior -->
      <string id="DisableAutoConnect_Name">Disable auto-connect</string>
      <string id="DisableAutoConnect_Help">When enabled, the NetBird tunnel does not auto-connect at daemon startup. Equivalent to --disable-auto-connect.</string>

      <string id="DisableAutostart_Name">Disable autostart</string>
      <string id="DisableAutostart_Help">When enabled, the NetBird GUI is prevented from registering itself as an OS autostart entry on fresh installs, and any existing OS autostart entry registration is removed on the next GUI launch (Windows Registry Run key, macOS Login Item, Linux .desktop). Once the admin lifts the policy, the setting stays off until the user re-enables it in Settings.</string>

      <string id="DisableClientRoutes_Name">Disable client routes</string>
      <string id="DisableClientRoutes_Help">When enabled, this client will not consume routes advertised by routing peers. Equivalent to --disable-client-routes.</string>

      <string id="DisableServerRoutes_Name">Disable server routes</string>
      <string id="DisableServerRoutes_Help">When enabled, this client will not act as a routing peer for other clients. Equivalent to --disable-server-routes.</string>

      <string id="BlockInbound_Name">Block inbound</string>
      <string id="BlockInbound_Help">When enabled, the client firewall blocks all inbound peer traffic on the WireGuard interface. Equivalent to --block-inbound.</string>

      <string id="AllowServerSSH_Name">Allow server SSH</string>
      <string id="AllowServerSSH_Help">When enabled, this client accepts incoming SSH sessions via NetBird SSH. Equivalent to --allow-server-ssh.</string>
      <string id="AllowServerVNC_Name">Allow server VNC</string>
      <string id="AllowServerVNC_Help">When enabled, this client accepts incoming remote desktop (VNC) sessions via NetBird. Equivalent to --allow-server-vnc.</string>
      <string id="DisableVNCApproval_Name">Disable VNC connection approval</string>
      <string id="DisableVNCApproval_Help">When enabled, incoming VNC sessions are accepted without prompting the local user for approval.</string>

      <string id="AllowRemoteJobs_Name">Allow remote jobs</string>
      <string id="AllowRemoteJobs_Help">When enabled, this client accepts management-requested remote jobs (e.g. debug bundles). Off by default. Equivalent to --allow-remote-jobs.</string>

      <string id="DebugBundleUploadURL_Name">Debug bundle upload URL</string>
      <string id="DebugBundleUploadURL_Help">Overrides the upload service used for debug bundles produced by remote jobs, taking precedence over the value requested by management. Must be an https URL with a host.</string>

      <string id="RosenpassEnabled_Name">Enable Rosenpass</string>
      <string id="RosenpassEnabled_Help">Enables Rosenpass post-quantum key exchange on WireGuard tunnels. Both peers must support it.</string>

      <string id="RosenpassPermissive_Name">Rosenpass permissive</string>
      <string id="RosenpassPermissive_Help">When enabled, the client falls back to plain WireGuard if a peer does not support Rosenpass; otherwise it refuses the connection.</string>

      <string id="WireguardPort_Name">WireGuard port</string>
      <string id="WireguardPort_Help">UDP port used by the local WireGuard interface. Allowed range: 1-65535.</string>
      <string id="LazyConnection_Name">Lazy connections</string>
      <string id="LazyConnection_Help">Local override for lazy connections. Enabled forces lazy connections on, Disabled forces them off, and leaving the policy Not Configured defers to the Management setting. The NB_LAZY_CONN environment variable takes precedence over this policy.</string>
      <string id="EnableLocalMetrics_Name">Enable local metrics endpoint</string>
      <string id="EnableLocalMetrics_Help">Exposes the client's local Prometheus /metrics endpoint. Unrelated to "Disable metrics collection".</string>
      <string id="LocalMetricsAddress_Name">Local metrics listen address</string>
      <string id="LocalMetricsAddress_Help">Listen address of the local Prometheus /metrics endpoint. Defaults to 127.0.0.1:9191 when the endpoint is enabled and this policy is Not Configured.</string>

      <string id="ExtraIFaceBlackList_Name">Extra interface blacklist</string>
      <string id="ExtraIFaceBlackList_Help">Interface name prefixes whose local addresses NetBird never offers as peer connection candidates, comma-separated. Matching is a case-sensitive name prefix with no wildcards: "vEthernet" excludes every Hyper-V and WSL adapter, so keep entries specific. The entries are added to the built-in list and to the device's own --extra-iface-blacklist entries, never replace them, and are not written to the device configuration. Only local candidates are filtered: traffic to the Relay, Signal and Management services, and to peers reached through a public address, still follows the operating system routing table.</string>

      <string id="DisableDNS_Name">Disable DNS</string>
      <string id="DisableDNS_Help">When enabled, the client does not configure DNS settings on this device. Disabled forces DNS management on. Equivalent to --disable-dns.</string>

      <string id="DisableIPv6_Name">Disable IPv6 overlay</string>
      <string id="DisableIPv6_Help">When enabled, the client does not request or use an IPv6 overlay address. Disabled lets it use one when the account provides it. Equivalent to --disable-ipv6.</string>

      <string id="DisableFirewall_Name">Disable firewall management</string>
      <string id="DisableFirewall_Help">When enabled, the client does not modify firewall rules on this device. Disabled forces firewall management on. Equivalent to --disable-firewall.</string>

      <string id="BlockLANAccess_Name">Block LAN access</string>
      <string id="BlockLANAccess_Help">When enabled, peers that use this device as a router or exit node cannot reach its local network. Equivalent to --block-lan-access.</string>

      <string id="DisableNotifications_Name">Disable notifications</string>
      <string id="DisableNotifications_Help">When enabled, the NetBird desktop app shows no notifications. Disabled forces them on.</string>

      <string id="NetworkMonitor_Name">Network monitor</string>
      <string id="NetworkMonitor_Help">When enabled, the client reconnects when the device's network changes. Disabled turns the monitor off. Equivalent to --network-monitor.</string>

      <string id="DisableIPv6Discovery_Name">Disable IPv6 candidate discovery</string>
      <string id="DisableIPv6Discovery_Help">When enabled, peer connections are negotiated over IPv4 only: no IPv6 connection candidates are gathered or used. It does not change the IPv6 overlay address.</string>

      <string id="MTU_Name">MTU</string>
      <string id="MTU_Help">MTU of the NetBird network interface. Allowed range: 576-8192. Equivalent to --mtu.</string>

      <string id="InterfaceName_Name">Interface name</string>
      <string id="InterfaceName_Help">Name of the NetBird network interface. On macOS it must be utun followed by a number, for example utun100; an invalid name is ignored and the previous name is kept. Equivalent to --interface-name.</string>

      <string id="DNSRouteInterval_Name">DNS route update interval</string>
      <string id="DNSRouteInterval_Help">How often routes for domain-based networks are refreshed, as a duration such as 30s, 1m or 1m30s. A value that is not a positive duration is ignored. Equivalent to --dns-router-interval.</string>

      <string id="NATExternalIPs_Name">External IP mappings</string>
      <string id="NATExternalIPs_Help">Public addresses to offer as connection candidates when the device sits behind a static NAT, comma-separated. Each entry is an external IP, optionally followed by /internal-IP or /interface, for example 203.0.113.7/10.0.0.5. Replaces the device's own --external-ip-map value. Invalid entries are skipped by the client.</string>
      <string id="ForceRelay_Name">Force relay</string>
      <string id="ForceRelay_Help">When enabled, the client never tries a direct connection and reaches every peer through a relay. Disabled allows direct connections. Overrides the device's --force-relay setting and the NB_FORCE_RELAY environment variable. Equivalent to --force-relay.</string>

      <string id="EnableSSHRoot_Name">Allow SSH root login</string>
      <string id="EnableSSHRoot_Help">When enabled, the NetBird SSH server accepts logins as root. Disabled refuses them. Applies while the SSH server is allowed. Equivalent to --enable-ssh-root.</string>

      <string id="EnableSSHSFTP_Name">Allow SSH file transfer (SFTP)</string>
      <string id="EnableSSHSFTP_Help">When enabled, the NetBird SSH server offers SFTP file transfer. Disabled turns it off. Equivalent to --enable-ssh-sftp.</string>

      <string id="EnableSSHLocalPortForwarding_Name">Allow SSH local port forwarding</string>
      <string id="EnableSSHLocalPortForwarding_Help">When enabled, an SSH client can reach other services through this device (ssh -L). Disabled refuses it. Equivalent to --enable-ssh-local-port-forwarding.</string>

      <string id="EnableSSHRemotePortForwarding_Name">Allow SSH remote port forwarding</string>
      <string id="EnableSSHRemotePortForwarding_Help">When enabled, an SSH client can make this device listen on a port and forward it back to the client (ssh -R). Disabled refuses it. Equivalent to --enable-ssh-remote-port-forwarding.</string>

      <string id="DisableSSHAuth_Name">Disable SSH user authentication</string>
      <string id="DisableSSHAuth_Help">When enabled, the NetBird SSH server lets in any peer the access policy allows, with no user login. Disabled requires the login. Meant for hosts reached only by automation. Equivalent to --disable-ssh-auth.</string>

      <string id="SSHJWTCacheTTL_Name">SSH login token cache</string>
      <string id="SSHJWTCacheTTL_Help">How long, in seconds, this device keeps the login token it uses to open NetBird SSH sessions to other peers, so the user does not log in again for every connection. 0 disables the cache. Equivalent to --ssh-jwt-cache-ttl.</string>
      <string id="KeepConnectedOnQuit_Name">Keep connected when the app quits</string>
      <string id="KeepConnectedOnQuit_Help">When enabled, quitting the NetBird desktop app leaves the connection up. Disabled disconnects on quit. The user cannot change it in the app.</string>
      <string id="DefaultLanguage_Name">Default app language</string>
      <string id="DefaultLanguage_Help">Language code the NetBird desktop app switches to when this policy is first applied or its value changes, for example it, de or zh-CN. The user can pick another language afterwards. Supported: en, de, es, fr, gl, he, hu, it, ja, ko, pl, pt, ru, uk, zh-CN, zh-HK.</string>
      <string id="DefaultViewMode_Name">Default app view</string>
      <string id="DefaultViewMode_Help">View the NetBird desktop app switches to when this policy is first applied or its value changes. The user can switch view afterwards. To lock the default view, use the policy that disables the advanced view instead.</string>
      <string id="DefaultViewMode_Default">Default</string>
      <string id="DefaultViewMode_Advanced">Advanced</string>
      <string id="DefaultTheme_Name">Default app theme</string>
      <string id="DefaultTheme_Help">Theme the NetBird desktop app switches to when this policy is first applied or its value changes. The user can pick another theme afterwards.</string>
      <string id="DefaultTheme_System">Follow the system</string>
      <string id="DefaultTheme_Light">Light</string>
      <string id="DefaultTheme_Dark">Dark</string>

      <string id="SplitTunnel_Name">Split tunnel</string>
      <string id="SplitTunnel_Help">Restrict the NetBird tunnel to or from a chosen list of application package names. Choose either the allow mode (only the listed apps route through NetBird) or the disallow mode (the listed apps bypass NetBird; everything else routes through). The mode is mutually exclusive — only one can be active at a time. Android-only at the daemon level; Windows/macOS/iOS clients ignore this policy.</string>
      <string id="AllowGroups_Name">Restrict the daemon sockets</string>
      <string id="AllowGroups_Help">Restrict the NetBird daemon control pipe, and the JSON socket where it is enabled, to the listed principals. Accounts outside them cannot connect at all, so nothing the daemon exposes is reachable from them; LocalSystem and elevated administrators are never locked out. Enter security identifiers in sid:S-1-5-21-... form, comma-separated, because the daemon reads this while starting and must not wait on a domain controller to resolve a name. An empty value lifts a restriction that was set when the service was installed.</string>
      <string id="SplitTunnel_Allow">Allow only listed apps (everything else bypasses)</string>
      <string id="SplitTunnel_Disallow">Disallow listed apps (everything else routes)</string>

      <!-- UI -->
      <string id="DisableUpdateSettings_Name">Disable update settings</string>
      <string id="DisableUpdateSettings_Help">When enabled, blocks every configuration change from the client UI and from the CLI (netbird up / login / setconfig). The Settings view stays viewable but read-only. Equivalent to --disable-update-settings.</string>

      <string id="DisableProfiles_Name">Disable profiles</string>
      <string id="DisableProfiles_Help">When enabled, the client UI/CLI cannot list, create, switch or remove NetBird connection profiles. Equivalent to --disable-profiles.</string>

      <string id="DisableNetworks_Name">Disable networks</string>
      <string id="DisableNetworks_Help">When enabled, the client UI/CLI cannot list, select or deselect NetBird networks (the corresponding daemon RPCs return Unavailable). Equivalent to --disable-networks.</string>

      <string id="DisableAdvancedView_Name">Disable advanced view</string>
      <string id="DisableAdvancedView_Help">When enabled, the client hides the advanced section of its interface. This policy only changes what the interface offers: it is not part of the daemon configuration and never causes a configuration change to be rejected. Setting it to Disabled explicitly re-enables the section.</string>

      <string id="DisableMetricsCollection_Name">Disable metrics collection</string>
      <string id="DisableMetricsCollection_Help">Reserved for a future client telemetry feature. The client recognizes this setting but it has no effect in current releases.</string>

    </stringTable>
    <presentationTable>

      <presentation id="ManagementURL_Pres">
        <textBox refId="ManagementURL_Text">
          <label>Management URL:</label>
          <defaultValue>https://api.netbird.io:443</defaultValue>
        </textBox>
      </presentation>

      <presentation id="DebugBundleUploadURL_Pres">
        <textBox refId="DebugBundleUploadURL_Text">
          <label>Debug bundle upload URL:</label>
        </textBox>
      </presentation>

      <presentation id="PreSharedKey_Pres">
        <textBox refId="PreSharedKey_Text">
          <label>Pre-shared key:</label>
        </textBox>
      </presentation>

      <presentation id="WireguardPort_Pres">
        <decimalTextBox refId="WireguardPort_Decimal" defaultValue="51820">WireGuard UDP port:</decimalTextBox>
      </presentation>
      <presentation id="LocalMetricsAddress_Pres">
        <textBox refId="LocalMetricsAddress_Text">
          <label>Listen address:</label>
          <defaultValue>127.0.0.1:9191</defaultValue>
        </textBox>
      </presentation>

      <presentation id="ExtraIFaceBlackList_Pres">
        <textBox refId="ExtraIFaceBlackList_Text">
          <label>Interface name prefixes (comma-separated):</label>
        </textBox>
      </presentation>

      <presentation id="MTU_Pres">
        <decimalTextBox refId="MTU_Decimal" defaultValue="1280">MTU:</decimalTextBox>
      </presentation>

      <presentation id="InterfaceName_Pres">
        <textBox refId="InterfaceName_Text">
          <label>Interface name:</label>
        </textBox>
      </presentation>

      <presentation id="DNSRouteInterval_Pres">
        <textBox refId="DNSRouteInterval_Text">
          <label>Interval (e.g. 1m30s):</label>
        </textBox>
      </presentation>

      <presentation id="NATExternalIPs_Pres">
        <textBox refId="NATExternalIPs_Text">
          <label>Mappings (comma-separated):</label>
        </textBox>
      </presentation>

      <presentation id="SSHJWTCacheTTL_Pres">
        <decimalTextBox refId="SSHJWTCacheTTL_Decimal" defaultValue="0">Seconds:</decimalTextBox>
      </presentation>

      <presentation id="DefaultLanguage_Pres">
        <textBox refId="DefaultLanguage_Text">
          <label>Language code:</label>
        </textBox>
      </presentation>

      <presentation id="DefaultViewMode_Pres">
        <dropdownList refId="DefaultViewMode_Enum" defaultItem="0">View:</dropdownList>
      </presentation>

      <presentation id="DefaultTheme_Pres">
        <dropdownList refId="DefaultTheme_Enum" defaultItem="0">Theme:</dropdownList>
      </presentation>

      <presentation id="AllowGroups_Pres">
        <textBox refId="AllowGroups_Text">
          <label>Allowed SIDs (comma-separated):</label>
        </textBox>
      </presentation>

      <presentation id="SplitTunnel_Pres">
        <dropdownList refId="SplitTunnel_Mode" defaultItem="0">Mode:</dropdownList>
        <textBox refId="SplitTunnel_Apps">
          <label>Package names (comma-separated):</label>
        </textBox>
      </presentation>

    </presentationTable>
  </resources>
</policyDefinitionResources>
