      "Checks": {
        "OSVersionCheck": {
          "Linux": {"MinKernelVersion": "6.0.0"},
          "Darwin": {"MinVersion": "13.0"}
        }
      }
    }
  },
  "Policies": [
    {
      "ID": "pol-os",
      "Enabled": true,
      "SourcePostureChecks": ["chk-os"],
      "Rules": [
        {
          "Enabled": true,
          "Action": "accept",
          "Protocol": "tcp",
          "Ports": ["443"],
          "Bidirectional": true,
          "Sources": ["grp-clients"],
          "Destinations": ["grp-srv"]
        }
      ]
    }
  ]
