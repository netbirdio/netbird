# netbird executable
/usr/bin/netbird			--	gen_context(system_u:object_r:netbird_exec_t,s0)
/usr/sbin/netbird			--	gen_context(system_u:object_r:netbird_exec_t,s0)
/usr/local/bin/netbird			--	gen_context(system_u:object_r:netbird_exec_t,s0)

# netbird configuration
/etc/netbird(/.*)?				gen_context(system_u:object_r:netbird_etc_t,s0)

# ssh client configuration written by the daemon
/etc/ssh/ssh_config\.d/99-netbird\.conf(\.tmp)?	--	gen_context(system_u:object_r:netbird_ssh_conf_t,s0)

# routing table name drop-in (the directory is shared and keeps its label)
/etc/iproute2/rt_tables\.d/netbird\.conf	--	gen_context(system_u:object_r:netbird_rt_tables_t,s0)

# netbird state files
/var/lib/netbird(/.*)?				gen_context(system_u:object_r:netbird_var_lib_t,s0)

# netbird log files
/var/log/netbird(/.*)?				gen_context(system_u:object_r:netbird_var_log_t,s0)
/var/log/netbird\.(out|err)\.log	--	gen_context(system_u:object_r:netbird_var_log_t,s0)

# netbird runtime files (daemon socket, userspace WireGuard sockets). EL8 and EL9 map
# /run to /var/run before matching, so every /run entry has a /var/run twin there.
/run/netbird(/.*)?				gen_context(system_u:object_r:netbird_runtime_t,s0)
/var/run/netbird(/.*)?				gen_context(system_u:object_r:netbird_runtime_t,s0)
/run/netbird.*\.sock			-s	gen_context(system_u:object_r:netbird_runtime_t,s0)
/var/run/netbird.*\.sock			-s	gen_context(system_u:object_r:netbird_runtime_t,s0)
/run/wireguard(/.*)?				gen_context(system_u:object_r:netbird_wg_runtime_t,s0)
/var/run/wireguard(/.*)?				gen_context(system_u:object_r:netbird_wg_runtime_t,s0)
