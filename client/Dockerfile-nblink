# nblink runs unprivileged: no TUN device, no capabilities, no host networking.
#
# The image is built for platforms that assign an arbitrary UID at run time, so
# it must not depend on a passwd entry and its state directory has to be
# writable by the root group rather than by one named user.
FROM alpine:3.22 AS build

# Group 0 owns the state directory and the group bits mirror the owner bits, so
# a container started as any UID in group 0 can still persist its identity.
RUN mkdir -p /tmp/var/lib/nblink \
    && chgrp -R 0 /tmp/var/lib/nblink \
    && chmod -R g=u /tmp/var/lib/nblink

FROM gcr.io/distroless/static-debian13:nonroot

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/nblink /usr/local/bin/nblink
COPY --from=build --chown=65532:0 /tmp/var/lib/nblink /var/lib/nblink

# Numeric so the runtime can substitute its own UID without a passwd lookup.
USER 65532:0

ENV NB_STATE_DIR=/var/lib/nblink \
    NB_LOG_LEVEL=info

ENTRYPOINT ["/usr/local/bin/nblink"]
